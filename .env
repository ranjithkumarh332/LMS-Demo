# ============================================================
# Copy this file to .env and fill in real values before running.
# Nothing in this file is read unless a matching .env exists.
# ============================================================

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017
DB_NAME=eip


# ---- JWT ----
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=9d7c1f8a4b2e6f91c3a8d7e5f0b9a6c4e2d1f8a7b6c5d4e3f2a1
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12
# Set to true once you are serving the app over HTTPS.
JWT_COOKIE_SECURE=false
JWT_COOKIE_CSRF_PROTECT=false

# ---- CORS ----
# Comma-separated list of origins allowed to call the API.
FRONTEND_ORIGIN=http://localhost:5000

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=200 per day;50 per hour
# Swap for a real Redis URI in production, e.g. redis://localhost:6379
RATE_LIMIT_STORAGE_URI=memory://

# ---- Super Admin (the ONE hardcoded account, per spec) ----
SUPER_ADMIN_EMAIL=login@superadmin.in
SUPER_ADMIN_PASSWORD=Superadmin@123

# ---- OTP (development stand-in for a real email service) ----
# Mock OTP only — email sending is disabled. Every OTP validation accepts
# this single code (Phase 1 requirement).
OTP_DEV_CODE=2026
OTP_EXPIRY_MINUTES=10
OTP_TOKEN_EXPIRY_MINUTES=15

# ---- Google Sign-In (Firebase Admin SDK) ----
# Path to a Firebase service-account JSON key. Leave blank to disable
# Google Sign-In (the /api/auth/google endpoint will return 501).
FIREBASE_CREDENTIALS_PATH=
DEFAULT_GOOGLE_SIGNUP_ROLE=student

# ---- Flask server ----
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
